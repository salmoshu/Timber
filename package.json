{
  "name": "timber",
  "version": "0.6.7",
  "description": "Timber —— 项目理解工具：Git 历史 × 架构图 × 代码阅读 × 文档渲染，看清每一次提交如何塑造你的项目",
  "author": "Winchell.Hu <winchell.hu@outlook.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/install-native.mjs && node scripts/copy-vditor-libs.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "predev": "node scripts/install-native.mjs && node scripts/copy-vditor-libs.mjs && node scripts/build-sidecar.mjs",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "node scripts/copy-vditor-libs.mjs && node scripts/build-sidecar.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite preview",
    "dist": "node scripts/run-electron-builder.cjs",
    "dist:publish": "node scripts/run-electron-builder.cjs --publish",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "vditor": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
